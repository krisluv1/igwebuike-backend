# =============================================
#  IgwebuIke Backend - Environment Variables
# =============================================
# Copy this file to ".env" and fill in your values.
# NEVER commit your real .env file to GitHub.

# --- MongoDB Atlas ---
# Get this from: MongoDB Atlas > Connect > Drivers > Node.js
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/igwebuike?retryWrites=true&w=majority

# --- Server Port (Render sets this automatically; keep 5000 for local) ---
PORT=5000

# --- Frontend URL (used for CORS) ---
# Local dev: http://127.0.0.1:5500
# Production: https://your-site.netlify.app
FRONTEND_URL=http://127.0.0.1:5500
