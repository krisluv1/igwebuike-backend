# Copy to ".env". NEVER commit the real .env.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/igwebuike?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development            # set to "production" on Render
FRONTEND_URL=http://127.0.0.1:5500

# REQUIRED: 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: matching service (see ../ml-service). Without these the site uses keyword matching.
# ML_INTERNAL_KEY must be 24+ random chars and identical on both services.
ML_SERVICE_URL=
ML_INTERNAL_KEY=
